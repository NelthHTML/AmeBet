rules_version = '2';

/* AmeBet — une salle = un carnet partagé entre organisateurs.
   Lecture/écriture réservées aux sessions authentifiées (connexion
   anonyme suffit : Firebase Console → Authentication → Anonyme).
   Durcis-le plus tard en listant les uid autorisés par salle. */

service cloud.firestore {
  match /databases/{database}/documents {

    match /rooms/{room} {
      allow read, write: if request.auth != null;

      match /fights/{fight} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && request.resource.data.a is string
          && request.resource.data.b is string
          && request.resource.data.bets is list
          && request.resource.data.bets.size() < 500;
        allow delete: if request.auth != null;
      }

      /* Journal des actions : on ajoute, on marque « annulé », on n'efface pas. */
      match /logs/{entry} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.by is string
          && request.resource.data.at is number
          && request.resource.data.label is string;
        allow update: if request.auth != null;
        allow delete: if false;
      }

      /* meta/settings porte les réglages partagés de la salle : part de
         l'organisateur, mode de cotes, forfaits, spectateurs, séances
         archivées, le tournoi en cours et les tournois archivés.
         Écrit en merge par lots — on borne juste la taille du document. */
      match /meta/{doc} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && request.resource.data.keys().size() < 40;
      }
    }
  }
}
