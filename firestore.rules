rules_version = '2';

/* AmeBet — règles Firestore.

   Modèle de données écrit par amebet-store.js :

     rooms/{salle}/fights/{combat}   { a, b, winner, bets[], createdMs, settledMs, createdAt }
     rooms/{salle}/meta/settings     { mode, rates, … }  (réglages partagés)

   Les organisateurs se connectent en anonyme (Authentication → Anonyme).
   Tout le monde partage donc la même salle : il n'y a pas de notion de
   propriétaire, seulement des garde-fous de forme et de volume pour qu'un
   visiteur mal intentionné ne puisse pas gonfler la base.

   Déploiement :  firebase deploy --only firestore:rules
*/

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Le nom de salle vient de l'URL (?salle=…). Le client le normalise quand
    // on l'édite dans le champ « Salle », mais pas quand il arrive brut par
    // l'URL : on tolère donc les majuscules. Sans cette vérification,
    // n'importe qui pourrait créer une infinité de salles aux noms arbitraires.
    function validRoom(room) {
      return room is string
          && room.size() > 0 && room.size() <= 40
          && room.matches('^[A-Za-z0-9-]+$');
    }

    function validFight() {
      let d = request.resource.data;
      return d.a is string && d.a.size() <= 80
          && d.b is string && d.b.size() <= 80
          && (!('winner' in d) || d.winner == null || d.winner in ['a', 'b'])
          && d.bets is list && d.bets.size() <= 300
          && d.createdMs is number;
    }

    match /rooms/{room} {

      // Le document de salle lui-même ne porte rien : seules ses
      // sous-collections sont utilisées.
      allow read: if signedIn() && validRoom(room);
      allow write: if false;

      match /fights/{fight} {
        allow read:            if signedIn() && validRoom(room);
        allow create, update:  if signedIn() && validRoom(room) && validFight();
        allow delete:          if signedIn() && validRoom(room);
      }

      match /meta/settings {
        allow read:  if signedIn() && validRoom(room);
        allow write: if signedIn() && validRoom(room)
                     && request.resource.data.size() <= 20;
      }
    }

    // Rien d'autre n'est déclaré : tout chemin hors de rooms/ est refusé par
    // défaut. (Un match /{document=**} explicite serait inutile ici — les
    // règles s'additionnent, un « allow ... if false » n'annule rien.)
  }
}
